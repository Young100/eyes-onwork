rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Vérifie l'authentification et l'email vérifié
    function isVerifiedUser(userId) {
      return request.auth != null &&
             request.auth.uid == userId &&
             request.auth.token.email_verified == true;
    }

    // Interdiction stricte de tout format exécutable, script ou dangereux (insensible à la casse, .svg inclus)
    function isSafeFile() {
      return !(request.resource.name.matches('(?i).*\\.(exe|bat|cmd|sh|php|phtml|php3|php4|php5|py|pyc|js|mjs|cjs|ts|vbs|jar|bin|msi|com|scr|cpl|dll|reg|hta|html|htm|svg)')) &&
             !(request.resource.contentType.matches('(?i)image/svg\\+xml|application/x-msdownload|application/x-executable|application/javascript|text/html|application/x-sh'));
    }

    // Limite de taille stricte (50 Mo maximum)
    function isValidSize() {
      return request.resource.size <= 50 * 1024 * 1024;
    }

    // SÉCURITÉ ZERO-TRUST : Fichiers seulement sous /users/{uid}/**
    // Accès uniquement si request.auth.uid == uid et email vérifié.
    // Aucun accès super admin aux fichiers des utilisateurs.
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if isVerifiedUser(userId);
      allow create, update: if isVerifiedUser(userId) && isSafeFile() && isValidSize();
    }

    // REFUS STRICT PAR DÉFAUT (fermeture de /workspaces, /projects, /uploads, etc.)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
