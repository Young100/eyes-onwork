rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FONCTIONS D'AIDE & CONTRÔLE D'ACCÈS ZERO-TRUST
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    // Le rôle Super Administrateur est validé exclusivement par Custom Claim Firebase Auth
    // Aucun email n'est écrit en dur dans les règles de sécurité.
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.admin == true
      );
    }

    // =========================================================================
    // 1. PROFILS UTILISATEURS (/users/{uid})
    // =========================================================================
    // - Lecture et écriture seulement si request.auth.uid == uid (ou superadmin)
    // - Les champs sensibles (role, plan, emailVerified, workspaceId, termsAcceptedVersion)
    //   ne sont JAMAIS modifiables par le client : seul le serveur (Admin SDK) les écrit.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      
      // À la création, interdiction absolue des clés sensibles (seul le serveur Admin SDK les initialise)
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny([
          'role',
          'plan',
          'emailVerified',
          'workspaceId',
          'termsAcceptedVersion',
          'isSuperAdmin',
          'admin'
        ]);

      // À la mise à jour, protection stricte contre toute modification de ces clés par le client
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 
            'plan', 
            'emailVerified', 
            'workspaceId', 
            'termsAcceptedVersion',
            'isSuperAdmin',
            'admin'
          ])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. DONNÉES D'UN WORKSPACE (ACCÈS PROPRIÉTAIRE UNIQUEMENT)
    // =========================================================================
    // Accès seulement si l'utilisateur en est le propriétaire légitime (resource.data.ownerId == request.auth.uid).

    // Espaces de travail : interdiction au client de modifier ownerId, plan et limites
    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'ownerId',
            'planId',
            'plan',
            'planStatus',
            'planBillingCycle',
            'planRenewsAt',
            'trialEndsAt',
            'storageLimitMb',
            'membersLimit',
            'storageUsedMb'
          ])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // Répertoire Clients
    match /clients/{clientId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Projets créatifs & livrables
    // Note sécurité : Le portail client par jeton passe par la route serveur dédiée (/api/portal/*).
    // Le navigateur client n'accède JAMAIS directement à cette collection sans compte propriétaire.
    match /projects/{projectId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      match /mockups/{mockupId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || 
          isSuperAdmin()
        );
      }

      match /deliverables/{deliverableId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || 
          isSuperAdmin()
        );
      }
    }

    // Devis : dès acceptation (status == 'accepted'), interdiction absolue de modification et de suppression
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin()) && resource.data.status != 'accepted';
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin()) && resource.data.status != 'accepted';
    }

    // Factures : verrouillage strict dès émission (statut autre que 'draft'). Seules les factures brouillon sont éditables/supprimables
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin()) && resource.data.status == 'draft';
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin()) && resource.data.status == 'draft';
    }

    // Paiements & transactions
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Catalogue des prestations, packs & modèles de devis
    match /catalog_services/{serviceId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /catalog_packs/{packId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /project_templates/{templateId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /custom_categories/{catId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Rendez-vous, Temps & Dépenses
    match /appointments/{aptId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /time_entries/{entryId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // =========================================================================
    // 3. COLLECTIONS STRICTEMENT RÉSERVÉES AU SERVEUR (AUCUN ACCÈS CLIENT)
    // =========================================================================
    // Les codes de vérification, journaux d'emails, abonnements et configurations
    // sont inaccessibles au SDK client (écriture et lecture gérées par Admin SDK).
    match /verification_codes/{codeId} {
      allow read, write: if false;
    }

    match /email_logs/{logId} {
      allow read, write: if false;
    }

    match /abonnements/{subId} {
      allow read, write: if false;
    }

    match /subscriptions/{subId} {
      allow read, write: if false;
    }

    match /platform_config/{docId} {
      allow read, write: if false;
    }

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /users_by_email/{emailKey} {
      allow read, write: if false;
    }

    // Demandes publiques de contact (formulaire prospect)
    match /leads/{leadId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 100 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.matches('.*@.*') &&
                       request.resource.data.description is string &&
                       request.resource.data.description.size() <= 3000 &&
                       (!('hp_field' in request.resource.data) || request.resource.data.hp_field == '');
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
    }

    // =========================================================================
    // 4. REFUS PAR DÉFAUT (ZERO TRUST DEFAULT-DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
