rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FONCTIONS D'AIDE & CONTRÔLE D'ACCÈS ZERO-TRUST DURCI
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Invariant fondamental : toute écriture exige impérativement que l'email soit vérifié
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isOwnerAndVerified(ownerId) {
      return isEmailVerified() && request.auth.uid == ownerId;
    }

    // Le rôle Super Administrateur est validé exclusivement par Custom Claim Firebase Auth
    // Aucun email n'est écrit en dur dans les règles de sécurité.
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.admin == true
      );
    }

    // Contrôle d'appartenance relationnelle : clientId doit appartenir au même propriétaire
    function clientBelongsToOwner(cId, ownerUid) {
      return cId == null || cId == '' || 
        get(/databases/$(database)/documents/clients/$(cId)).data.ownerId == ownerUid;
    }

    // Contrôle d'appartenance relationnelle : projectId doit appartenir au même propriétaire
    function projectBelongsToOwner(pId, ownerUid) {
      return pId == null || pId == '' || 
        get(/databases/$(database)/documents/projects/$(pId)).data.ownerId == ownerUid;
    }

    // =========================================================================
    // 1. PROFILS UTILISATEURS (/users/{uid})
    // =========================================================================
    // - Lecture : l'utilisateur lui-même ou super admin
    // - Création : email vérifié, interdiction absolue des champs sensibles (rôle, plan, etc.)
    // - Mise à jour : liste blanche stricte via affectedKeys().hasOnly()
    // - Suppression : super admin uniquement (avec email vérifié)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      
      allow create: if isEmailVerified() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny([
          'role',
          'plan',
          'planId',
          'emailVerified',
          'workspaceId',
          'termsAcceptedVersion',
          'termsAcceptedAt',
          'privacyAcceptedVersion',
          'privacyAcceptedAt',
          'onboardingCompleted',
          'onboardingCompletedAt',
          'isSuperAdmin',
          'admin'
        ]);

      // Liste blanche stricte des champs modifiables par le client
      allow update: if isEmailVerified() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'displayName',
            'studioName',
            'phone',
            'address',
            'siret',
            'tvaNumber',
            'website',
            'avatarUrl',
            'photoURL',
            'photo',
            'iban',
            'bic',
            'currency',
            'defaultVatRate',
            'vatRate',
            'defaultDepositPercent',
            'defaultTurnaroundWeeks',
            'defaultRevisionLimit',
            'termsTemplate',
            'legalNoticeTemplate',
            'legalNotice',
            'defaultConditionsQuote',
            'depositCalculation',
            'quotePrefix',
            'invoicePrefix',
            'maxFileSizeMb',
            'messageTemplates',
            'brandColor',
            'autoUnlockDeliveryOnFullPayment',
            'defaultProjectTemplateId',
            'logoUrl',
            'specialty',
            'accentColor',
            'countryCode',
            'timezone',
            'updatedAt',
            'language',
            'lang',
            'preferences',
            'theme',
            'showHelpBubbles',
            'legalNoticesByCountry',
            'bio'
          ])
        )
      );

      allow delete: if isEmailVerified() && isSuperAdmin();
    }

    // =========================================================================
    // 2. ESPACES DE TRAVAIL (/workspaces/{workspaceId})
    // =========================================================================
    // - Création : interdiction stricte de planId, plan, planStatus, trialEndsAt, storageLimitMb, membersLimit
    // - Mise à jour : ownerId inaltérable, quotas et plan inaltérables par le client
    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      
      allow create: if isOwnerAndVerified(request.resource.data.ownerId) &&
        !request.resource.data.keys().hasAny([
          'planId',
          'plan',
          'planStatus',
          'trialEndsAt',
          'storageLimitMb',
          'membersLimit',
          'storageUsedMb',
          'planBillingCycle',
          'planRenewsAt'
        ]);

      allow update: if isEmailVerified() && (
        isSuperAdmin() ||
        (
          resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'ownerId',
            'planId',
            'plan',
            'planStatus',
            'planBillingCycle',
            'planRenewsAt',
            'trialEndsAt',
            'storageLimitMb',
            'membersLimit',
            'storageUsedMb'
          ])
        )
      );

      allow delete: if isEmailVerified() && isSuperAdmin();
    }

    // =========================================================================
    // 3. ABONNEMENTS & SUBSCRIPTIONS (SUPER ADMIN & SERVEUR)
    // =========================================================================
    match /abonnements/{subId} {
      allow read, write: if isEmailVerified() && isSuperAdmin();
    }

    match /subscriptions/{subId} {
      allow read, write: if isEmailVerified() && isSuperAdmin();
    }

    // =========================================================================
    // 4. DONNÉES MÉTIER PRIVÉES DU WORKSPACE (SANS AUCUN ACCÈS SUPER ADMIN)
    // =========================================================================
    // Le Super Admin n'a AUCUN accès aux clients, projets, devis et factures.
    // L'isolation multi-tenant est absolue entre chaque graphiste / studio.

    // Répertoire Clients
    match /clients/{clientId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerAndVerified(request.resource.data.ownerId);
      allow update: if isEmailVerified() && 
                       resource.data.ownerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    // Projets créatifs & livrables
    // - clientShareToken et clientLinkActive sont réservés exclusivement au serveur
    // - clientId et projectId doivent appartenir au même propriétaire
    // - ownerId inaltérable à la mise à jour
    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      allow create: if isOwnerAndVerified(request.resource.data.ownerId) &&
        !request.resource.data.keys().hasAny(['clientShareToken', 'clientLinkActive']) &&
        clientBelongsToOwner(request.resource.data.clientId, request.auth.uid);

      allow update: if isEmailVerified() &&
        resource.data.ownerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'clientShareToken',
          'clientLinkActive',
          'ownerId'
        ]) &&
        clientBelongsToOwner(request.resource.data.clientId, request.auth.uid);

      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;

      match /mockups/{mockupId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow write: if isEmailVerified() && 
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      match /deliverables/{deliverableId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow write: if isEmailVerified() && 
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    // Devis :
    // - clientId et projectId doivent appartenir au même propriétaire (request.auth.uid)
    // - ownerId inaltérable à la mise à jour
    // - Dès acceptation (status == 'accepted'), verrouillage absolu
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isOwnerAndVerified(request.resource.data.ownerId) &&
        projectBelongsToOwner(request.resource.data.projectId, request.auth.uid) &&
        clientBelongsToOwner(request.resource.data.clientId, request.auth.uid);

      allow update: if isEmailVerified() && 
        resource.data.ownerId == request.auth.uid && 
        resource.data.status != 'accepted' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']) &&
        projectBelongsToOwner(request.resource.data.projectId, request.auth.uid) &&
        clientBelongsToOwner(request.resource.data.clientId, request.auth.uid);

      allow delete: if isEmailVerified() && 
        resource.data.ownerId == request.auth.uid && 
        resource.data.status != 'accepted';
    }

    // Factures :
    // - clientId et projectId doivent appartenir au même propriétaire (request.auth.uid)
    // - ownerId inaltérable à la mise à jour
    // - Verrouillage strict dès émission (statut autre que 'draft'). Seul le brouillon est éditable/supprimable
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isOwnerAndVerified(request.resource.data.ownerId) &&
        projectBelongsToOwner(request.resource.data.projectId, request.auth.uid) &&
        clientBelongsToOwner(request.resource.data.clientId, request.auth.uid);

      allow update: if isEmailVerified() && 
        resource.data.ownerId == request.auth.uid && 
        resource.data.status == 'draft' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']) &&
        projectBelongsToOwner(request.resource.data.projectId, request.auth.uid) &&
        clientBelongsToOwner(request.resource.data.clientId, request.auth.uid);

      allow delete: if isEmailVerified() && 
        resource.data.ownerId == request.auth.uid && 
        resource.data.status == 'draft';
    }

    // Paiements & transactions :
    // - Création seulement ! Aucun update ni delete (registre comptable inaltérable)
    // - clientId et projectId doivent appartenir au même propriétaire
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isOwnerAndVerified(request.resource.data.ownerId) &&
        projectBelongsToOwner(request.resource.data.projectId, request.auth.uid) &&
        clientBelongsToOwner(request.resource.data.clientId, request.auth.uid);

      allow update, delete: if false;
    }

    // Catalogue des prestations, packs & modèles de devis
    match /catalog_services/{serviceId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerAndVerified(request.resource.data.ownerId);
      allow update: if isEmailVerified() && 
                       resource.data.ownerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    match /catalog_packs/{packId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerAndVerified(request.resource.data.ownerId);
      allow update: if isEmailVerified() && 
                       resource.data.ownerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    match /project_templates/{templateId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerAndVerified(request.resource.data.ownerId);
      allow update: if isEmailVerified() && 
                       resource.data.ownerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    match /custom_categories/{catId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerAndVerified(request.resource.data.ownerId);
      allow update: if isEmailVerified() && 
                       resource.data.ownerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    // Rendez-vous, Temps & Dépenses
    match /appointments/{aptId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerAndVerified(request.resource.data.ownerId);
      allow update: if isEmailVerified() && 
                       resource.data.ownerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    match /time_entries/{entryId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerAndVerified(request.resource.data.ownerId);
      allow update: if isEmailVerified() && 
                       resource.data.ownerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isOwnerAndVerified(request.resource.data.ownerId);
      allow update: if isEmailVerified() && 
                       resource.data.ownerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    // Demandes publiques de prospects :
    // Aucune écriture directe via le SDK client ; seule la route serveur dédiée (Admin SDK) écrit dans /leads
    match /leads/{leadId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // =========================================================================
    // 5. COLLECTIONS STRICTEMENT RÉSERVÉES AU SERVEUR (AUCUN ACCÈS CLIENT)
    // =========================================================================
    match /verification_codes/{codeId} {
      allow read, write: if false;
    }

    match /email_logs/{logId} {
      allow read, write: if false;
    }

    match /platform_config/{docId} {
      allow read, write: if false;
    }

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /users_by_email/{emailKey} {
      allow read, write: if false;
    }

    // =========================================================================
    // 6. REFUS PAR DÉFAUT (ZERO TRUST DEFAULT-DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
