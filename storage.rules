rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Le rôle Super Administrateur est vérifié via custom claim
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.admin == true
      );
    }

    // Interdiction stricte de tout format exécutable ou dangereux
    function isSafeFile() {
      return !(request.resource.name.matches('.*\\.(exe|sh|php|js|bat|cmd|vbs|py|bin|jar|msi|html|htm|cgi|pl|phtml)')) &&
             !(request.resource.contentType.matches('application/x-msdownload|application/x-executable|application/javascript|text/html|application/x-sh'));
    }

    // Limite de taille stricte (50 Mo maximum)
    function isValidSize() {
      return request.resource.size <= 50 * 1024 * 1024;
    }

    // 1. Fichiers par utilisateur & logos (logos, avatars, signatures)
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin()) && isSafeFile() && isValidSize();
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // 2. Fichiers de l'espace de travail (branding, logos d'entreprise, exports)
    match /workspaces/{workspaceId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isSafeFile() && isValidSize();
      allow delete: if isAuthenticated();
    }

    // 3. Projets créatifs (maquettes, déclinaisons, fichiers sources & livrables)
    match /projects/{projectId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isSafeFile() && isValidSize();
      allow delete: if isAuthenticated();
    }

    // 4. Téléversements généraux authentifiés
    match /uploads/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin()) && isSafeFile() && isValidSize();
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // REFUS STRICT PAR DÉFAUT
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
